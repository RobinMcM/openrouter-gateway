# Required - Service will fail fast at startup if these are missing
INTERNAL_API_KEY=your-secret-internal-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional - OpenRouter configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional - Routing configuration (JSON inline or file path)
# ROUTING_CONFIG_JSON={"text-completion": {"provider": "openai", "model": "gpt-4", "endpoint": "/chat/completions"}}
# ROUTING_CONFIG_PATH=/app/routing.json

# Optional - Pricing configuration (JSON inline or file path)
# PRICING_CONFIG_JSON={"gpt-4": {"input_cost_per_1k": 0.03, "output_cost_per_1k": 0.06}}
# PRICING_CONFIG_PATH=/app/pricing.json

# Optional - Admin markup configuration
ADMIN_MARKUP_PERCENT=0.10
ADMIN_FIXED_FEE=0.001
